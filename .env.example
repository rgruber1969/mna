# Copie para .env e ajuste se necessário. O arquivo .env nunca vai para o git.

# Banco local (docker-compose.yml). Valores apenas para desenvolvimento.
POSTGRES_USER=mna
POSTGRES_PASSWORD=mna_dev
POSTGRES_DB=mna
POSTGRES_PORT=5432

# Conexões (ADR-0009). A aplicação usa um usuário SEM privilégio de contornar
# o RLS; só as migrações usam o dono das tabelas. 127.0.0.1 evita IPv6.
DATABASE_URL=postgresql://mna_app_login:mna_app_dev@127.0.0.1:5432/mna
DATABASE_URL_MIGRACAO=postgresql://mna:mna_dev@127.0.0.1:5432/mna
APP_DB_PASSWORD=mna_app_dev

# Banco de testes (criado por pnpm db:preparar).
DATABASE_URL_TESTE=postgresql://mna_app_login:mna_app_dev@127.0.0.1:5432/mna_teste
DATABASE_URL_MIGRACAO_TESTE=postgresql://mna:mna_dev@127.0.0.1:5432/mna_teste

# Nome comercial do produto (o codinome interno é MNA).
PRODUCT_NAME=MNA

# Documentação da API (Swagger) em produção: false por padrão.
API_DOCS_ENABLED=false

# Tarefas em segundo plano (Inngest). Em desenvolvimento, usa o servidor
# local do docker compose (painel: http://localhost:8288).
INNGEST_DEV=1
INNGEST_BASE_URL=http://127.0.0.1:8288
INNGEST_SERVE_ORIGIN=http://host.docker.internal:3000

# E-mail no desenvolvimento: Mailpit (caixa de entrada: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# Arquivos (ADR-0012). Local: RustFS no docker compose (console: http://localhost:9001).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=mna-arquivos
S3_ACCESS_KEY=mna_dev
S3_SECRET_KEY=mna_dev_segredo
S3_FORCE_PATH_STYLE=true

# Endereços (ADR-0011): console em admin.<domínio>, tenants em <slug>.<domínio>.
APP_DOMINIO=localhost:3000
APP_PROTOCOLO=http

# Autenticação (ADR-0005). Gere um valor próprio, nunca reutilize este:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=troque-por-um-valor-aleatorio-de-32-bytes

# Remetente dos e-mails (convites, link mágico).
EMAIL_REMETENTE=nao-responda@localhost

# Entrada de desenvolvimento (autenticacao-e-sessao.md): "sim" mostra, só em
# endereços *.localhost, a opção de entrar apenas com o e-mail. Nunca ligue
# fora do ambiente local: a aplicação recusa iniciar em produção com ela.
DEV_ENTRAR_SO_COM_EMAIL=nao

# Funcionalidades simuladas (src/config/funcionalidades.ts): modo de cada uma,
# "real", "simulada" (com aviso de demonstração) ou "desligada". Vazio: fora da
# produção, o que ainda não é real fica simulado; em produção, desligado. A
# aplicação recusa iniciar em produção com alguma simulada.
# Ex.: FUNCIONALIDADES=loginSocial:desligada,valuation:simulada
FUNCIONALIDADES=

# Backup criptografado dos dados locais (pnpm backup:gerar; adendo ao ADR-0002).
# Senha longa (16+ caracteres) definida por você; guarde a mesma no gerenciador
# de senhas: sem ela o backup não abre.
BACKUP_SENHA=

# Criptografia de campos sensíveis (ADR-0017 e adendo). Fora da produção, a
# chave mestra fica aqui; na produção, no AWS KMS. Gere com
# "pnpm cripto:gerar-chaves" (grava direto no .env, sem mostrar). Nunca troque
# a mestra depois de usar: os dados criptografados ficariam ilegíveis.
CRIPTO_CHAVE_MESTRA=
CRIPTO_CHAVE_INDICE=
