# Copie para .env e ajuste se necessário. O arquivo .env nunca vai para o git.

# Banco local (docker-compose.yml). Valores apenas para desenvolvimento.
POSTGRES_USER=mna
POSTGRES_PASSWORD=mna_dev
POSTGRES_DB=mna
POSTGRES_PORT=5432

# Conexão usada pela aplicação. Em produção, a Vercel injeta a do Neon.
DATABASE_URL=postgresql://mna:mna_dev@localhost:5432/mna

# Nome comercial do produto (o codinome interno é MNA).
PRODUCT_NAME=MNA

# Documentação da API (Swagger) em produção: false por padrão.
API_DOCS_ENABLED=false

# Tarefas em segundo plano (Inngest). Em desenvolvimento, usa o servidor
# local do docker compose (painel: http://localhost:8288).
INNGEST_DEV=1
INNGEST_BASE_URL=http://127.0.0.1:8288
INNGEST_SERVE_ORIGIN=http://host.docker.internal:3000

# E-mail no desenvolvimento: Mailpit (caixa de entrada: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
