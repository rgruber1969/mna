{
  "name": "mna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "arquivos:preparar": "node scripts/arquivos-preparar-local.mjs",
    "build": "next build",
    "console:convidar-admin": "tsx --env-file=.env scripts/console-convidar-admin.mts",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "node scripts/db-migrar.mjs",
    "db:migrar:teste": "node scripts/db-migrar.mjs teste",
    "db:preparar": "node scripts/db-preparar-local.mjs",
    "dev": "next dev",
    "dev:reiniciar": "node scripts/dev-reiniciar.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verificar": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "better-auth": "1.7.25",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "inngest": "^4.26.2",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
